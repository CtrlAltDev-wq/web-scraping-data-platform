# Copy this file to `.env` and adjust the values you need.
# Every variable is optional; defaults live in app/core/config.py.

APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Politeness settings for the crawler.
APP_USER_AGENT=Mozilla/5.0 (compatible; WebScrapingDataPlatform/0.1; +https://github.com/CtrlAltDev-wq/web-scraping-data-platform)
APP_REQUEST_TIMEOUT_SECONDS=15
APP_MAX_RETRIES=3
APP_RETRY_BACKOFF_SECONDS=1.0
APP_REQUEST_DELAY_SECONDS=0.5
APP_RESPECT_ROBOTS_TXT=true

# Scrape limits.
APP_DEFAULT_MAX_PAGES=3
APP_MAX_PAGES_LIMIT=20

# Where raw HTML, run outputs and exports are stored.
# APP_DATA_DIR=./data
